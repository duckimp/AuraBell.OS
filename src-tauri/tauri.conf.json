{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aurabell-os",
  "version": "0.1.0",
  "identifier": "com.aurabell.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run prepare:tts && npm run dev",
    "beforeBuildCommand": "npm run prepare:tts && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AuraBell.OS - Sistem Bel Sekolah & Pengumuman",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/tts/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
